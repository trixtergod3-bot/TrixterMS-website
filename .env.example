# All settings are server-side. Never prefix credentials or private API URLs with NEXT_PUBLIC_.
# Set before the production build; rebuild after changing the site URL or indexing flag.
# Apex is canonical; https://www.trixterms.com normalizes to https://trixterms.com.
# For a separate preview, use its HTTPS origin and keep TRIXTER_PUBLIC_LAUNCH=false.
# No credentials, non-default port, subpath, query, or fragment in this origin.
# HTTP loopback origins are accepted only with NODE_ENV=development/test.
TRIXTER_SITE_URL=https://trixterms.com
# Indexing requires production mode, the canonical origin, and this explicit true flag.
# Noindex metadata/headers, disallowed robots, and an empty sitemap remain the default.
TRIXTER_PUBLIC_LAUNCH=false
TRIXTER_READ_API_URL=
TRIXTER_DAILY_RANKINGS_ENABLED=false
TRIXTER_WEEKLY_RANKINGS_ENABLED=false
TRIXTER_REGISTRATION_ENABLED=false
TRIXTER_REGISTRATION_URL=
TRIXTER_REGISTRATION_GATEWAY_TOKEN=
TRIXTER_REGISTRATION_CSRF_SECRET=
TRIXTER_REGISTRATION_ABUSE_GUARD=
TRIXTER_REGISTRATION_PROXY_SECRET=
TRIXTER_DISCORD_INVITE_URL=
# Server-configured trixterms.web-downloads.v1 JSON snapshot; see docs.
TRIXTER_RELEASE_DOWNLOADS_JSON=
NEXT_TELEMETRY_DISABLED=1
